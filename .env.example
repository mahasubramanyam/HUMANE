# ==============================================================================
# HUMANE — Environment Configuration Template
# NOTE: This file contains placeholders only. Copy to .env for local development.
# NEVER commit real credentials, secrets, or API keys to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=HUMANE
LOG_LEVEL=INFO

# --- Frontend Settings ---
NEXT_PUBLIC_APP_NAME=HUMANE
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# --- Backend API Settings ---
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=humane_user
POSTGRES_PASSWORD=humane_secure_password_placeholder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=humane_db
DATABASE_URL=postgresql+asyncpg://humane_user:humane_secure_password_placeholder@localhost:5432/humane_db
# Sync database URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql+psycopg2://humane_user:humane_secure_password_placeholder@localhost:5432/humane_db

# --- Authentication & Session Security ---
# Generate a cryptographically secure random string with: openssl rand -hex 32
SESSION_SECRET_KEY=change_me_to_a_minimum_32_char_cryptographically_secure_random_string
SESSION_COOKIE_NAME=humane_session
SESSION_EXPIRE_SECONDS=86400
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CSRF_SECRET_KEY=change_me_to_a_minimum_32_char_random_csrf_token_secret

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Private Object Storage (Azure Blob / Local Mock) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./local_storage
AZURE_STORAGE_ACCOUNT_NAME=placeholder_account_name
AZURE_STORAGE_ACCOUNT_KEY=placeholder_account_key
AZURE_STORAGE_CONTAINER_NAME=humane-sensitive-documents
